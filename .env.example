# ── Database (Local PostgreSQL or Supabase) ──────────────────────────────────
# For Supabase:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://midday:midday_password@localhost:5432/midday_meal_ai?schema=public
DIRECT_URL=

POSTGRES_USER=midday
POSTGRES_PASSWORD=midday_password
POSTGRES_DB=midday_meal_ai

# ── API Server ────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=4000
API_PORT=4000

# ── Frontend & AI ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=mock
GEMINI_API_KEY=

